# Vite solo lee el .env de la raíz del proyecto (aquí), no el de otras carpetas.
# Aquí no van secretos: estas URLs terminan visibles en el navegador.

# Rutas relativas: el proxy de vite.config.js las reenvía desde este PC.
# Así funciona igual en localhost:5173 y por el túnel de VS Code.

# API Gateway (localhost:8080): backend real, hoy solo iam (/auth y /users)
VITE_API_URL=/api

# Mock (npm run mock-api, localhost:3100): lo que todavía no tiene backend real
VITE_MOCK_API_URL=/mock